# Copy to .env (gitignored) and fill in. Read by docker compose.

# Public hostname of the API (DNS A record → this server). Used by Caddy for HTTPS.
TRACE_DOMAIN=trace.example.com

# Absolute base for links in responses and callbacks.
TRACE_PUBLIC_URL=https://trace.example.com

# HMAC secret for callback signatures (X-TraceKit-Signature). Share it with the
# systems that receive callbacks. Generate: openssl rand -hex 32
TRACE_CALLBACK_SECRET=

# Optional: only these client networks may call the API (space-separated CIDRs),
# used when the @blocked lines in docker/Caddyfile are uncommented.
# TRACE_ALLOWED_CLIENTS=203.0.113.10/32 10.0.0.0/8

# Optional: Odoo hosts that requests may target (comma-separated). Empty = any.
TRACE_TARGET_ALLOWLIST=
